# Flask / App
FLASK_ENV=production
PORT=8000
BASE_URL=https://<your-app>.herokuapp.com

# Prompting (Meta Llama via OpenRouter)
OPENROUTER_API_KEY=your-openrouter-api-key-here
LLAMA_MODEL=meta-llama/llama-3.1-70b-instruct

# Image generation (OpenAI example; swap if you prefer)
OPENAI_API_KEY=your-openai-api-key-here

# Facebook Page API
FB_PAGE_ID=123456789012345
FB_PAGE_ACCESS_TOKEN=your-facebook-page-access-token

# Defaults
DEFAULT_POST_TIME=09:00

# Branding
BRAND_GREEN=#10B981
BRAND_FOOTER=ChatRefill • Top-up worldwide
# Choose one:
# BRAND_LOGO_PATH=/app/static/chatrefill-logo.png
# or
# BRAND_LOGO_URL=https://your-cdn/chatrefill-logo.png

# Optional font path for footer text
# BRAND_FONT_PATH=/app/static/Inter-SemiBold.ttf
